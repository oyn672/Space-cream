}

window.doHospitalHeal = function() {
    if (state.gold < 50) return showPixelToast('* 50$ GEREKLI!');
    state.gold -= 50; state.poisoned = false; state.hp = state.maxHp;
    document.getElementById('poison-vignette').style.display = 'none';
    sfx.playHeal(); updateHUD(); saveSlot(activeSlotIndex, state); showPixelToast('* TEDAVI EDILDI!'); openHospitalMenu();
};

window.doFinalCure = function() {
    if (state.gold < CURE_VACCINE_COST) return showPixelToast('* 100.000$ GEREKLI!');
    state.gold -= CURE_VACCINE_COST; state.alienGene = false; state.cured = true; state.poisoned = false;
    closeMenu(); buildPlayerVoxel(); sfx.playHeal(); updateHUD();
    recordEnding(1, 'SON 1: NORMAL ASILI SON', 'human', '* 100.000$ asiyi alip insanliga geri dondun!');
};

function openAchievementsMenu() {
    activeShopMenu = null;
    let html = `<div style="font-size:8px;color:#ffff00;">BASARIMLAR: ${state.achievements.length} / ${ACHIEVEMENTS.length}</div>`;
    ACHIEVEMENTS.forEach(a => {
        const unlocked = state.achievements.includes(a.id);
        html += `<div class="item-row"><div style="font-size:8px;color:${unlocked ? '#ffff00' : '#888'};">${a.title}</div><span style="font-size:7px;color:${unlocked ? '#00ff66' : '#666'};">${unlocked ? 'ACILDI' : 'KILIT'}</span></div>`;
    });
    showMenu('* BASARIMLAR', html);
}

function openBagMenu() {
    activeShopMenu = null;
    let html = '';
    Object.keys(state.bag.milks).forEach(mid => {
        const qty = state.bag.milks[mid];
        if (qty > 0) {
            const c = COW_CATALOG.find(x => x.id === mid);
            html += `<div class="item-row"><span style="font-size:8px;color:#00ffff;">${c ? c.milkName : mid} (x${qty})</span></div>`;
        }
    });
    Object.keys(state.bag.fruits).forEach(fid => {
        const qty = state.bag.fruits[fid];
        if (qty > 0) {
            const f = FRUIT_CATALOG.find(x => x.id === fid);
            html += `<div class="item-row"><span style="font-size:8px;color:#00ff66;">${f ? f.name : fid} (x${qty})</span></div>`;
        }
    });
    if ((state.bag.crystals || 0) > 0) {
        html += `<div class="item-row"><span style="font-size:8px;color:#cc44ff;">KRISTAL CEVHERI (x${state.bag.crystals})</span></div>`;
    }
    if (state.bag.crafted.antidote > 0) {
        html += `<div class="item-row"><span style="font-size:8px;color:#ffff00;">PANZEHIR (x${state.bag.crafted.antidote})</span><button onclick="doDrinkAntidote()" class="ut-btn ut-btn-green">IC</button></div>`;
    }
    if (!html) html = '<div style="font-size:8px;color:#888;">Cantan bos.</div>';
    showMenu('* CANTA', html);
}

window.doDrinkAntidote = function() {
    if (state.bag.crafted.antidote <= 0) return;
    state.bag.crafted.antidote--; state.poisoned = false;
    document.getElementById('poison-vignette').style.display = 'none';
    sfx.playHeal(); updateHUD(); saveSlot(activeSlotIndex, state); openBagMenu();
};

function updateHUD() {
    document.getElementById('hud-name').innerText = state.name;
    document.getElementById('hud-gold').innerText = state.gold.toLocaleString('tr-TR');
    document.getElementById('hud-hp-num').innerText = `${Math.ceil(state.hp)}/${state.maxHp}`;
    document.getElementById('hud-hp-fill').style.width = `${(state.hp / state.maxHp) * 100}%`;
    document.getElementById('hud-planet-tag').innerText = `[${PLANETS[state.planet].name}]`;
    const timerEl = document.getElementById('hud-restock-timer');
    if (timerEl) timerEl.innerText = `${getRemainingRestockSec()}s`;
}

function setQuest(txt) { document.getElementById('quest-text').innerText = txt; }

const joyArea = document.getElementById('joy-area');
const joyKnob = document.getElementById('joy-knob');
let joyVec = { x: 0, y: 0 }, activeTouchId = null;

function handleJoyMove(touch) {
    const rect = joyArea.getBoundingClientRect();
    const cx = rect.left + rect.width / 2, cy = rect.top + rect.height / 2;
    let dx = touch.clientX - cx, dy = touch.clientY - cy;
    const dist = Math.hypot(dx, dy), maxR = 34;
    if (dist > maxR) { dx = (dx / dist) * maxR; dy = (dy / dist) * maxR; }
    joyKnob.style.transform = `translate(${Math.round(dx)}px, ${Math.round(dy)}px)`;
    joyVec.x = dx / maxR; joyVec.y = dy / maxR;
}

joyArea.addEventListener('touchstart', (e) => { e.preventDefault(); const t = e.changedTouches[0]; activeTouchId = t.identifier; handleJoyMove(t); }, { passive: false });
joyArea.addEventListener('touchmove', (e) => { e.preventDefault(); for (let i = 0; i < e.changedTouches.length; i++) if (e.changedTouches[i].identifier === activeTouchId) handleJoyMove(e.changedTouches[i]); }, { passive: false });
const stopJoy = (e) => { for (let i = 0; i < e.changedTouches.length; i++) if (e.changedTouches[i].identifier === activeTouchId) { activeTouchId = null; joyVec = { x: 0, y: 0 }; joyKnob.style.transform = 'translate(0px, 0px)'; } };
joyArea.addEventListener('touchend', stopJoy);

let currentTrigger = null;
document.getElementById('btn-z').addEventListener('click', () => { if (currentTrigger) currentTrigger.onTrigger(); });
document.getElementById('btn-x').addEventListener('click', openBagMenu);
document.getElementById('btn-m').addEventListener('click', openMapMenu);
document.getElementById('btn-hud-map').addEventListener('click', openMapMenu);
document.getElementById('btn-hud-upgrades').addEventListener('click', openEasyUpgradesMenu);
document.getElementById('btn-hud-ach').addEventListener('click', openAchievementsMenu);
document.getElementById('btn-hud-pet').addEventListener('click', openPetShopMenu);
document.getElementById('btn-hud-cocop').addEventListener('click', openCocopMenu);
document.getElementById('btn-hud-save').addEventListener('click', () => saveSlot(activeSlotIndex, state, true));
document.getElementById('btn-hud-mute').addEventListener('click', () => sfx.toggleMute());
document.getElementById('btn-hud-menu').addEventListener('click', () => {
    saveSlot(activeSlotIndex, state);
    document.getElementById('top-hud').style.display = 'none';
    document.getElementById('quest-strip').style.display = 'none';
    document.getElementById('mobile-controls').style.display = 'none';
    document.getElementById('title-screen').style.display = 'flex';
    renderSaveSlotsUI();
});

document.getElementById('btn-ending-continue').addEventListener('click', () => { document.getElementById('ending-overlay').style.display = 'none'; });
document.getElementById('btn-ending-slots').addEventListener('click', () => {
    document.getElementById('ending-overlay').style.display = 'none';
    document.getElementById('top-hud').style.display = 'none';
    document.getElementById('quest-strip').style.display = 'none';
    document.getElementById('mobile-controls').style.display = 'none';
    document.getElementById('title-screen').style.display = 'flex';
    renderSaveSlotsUI();
});

let prevTime = performance.now(), walkPhase = 0, poisonTick = 0, autoMilkTick = 0, restockUiTick = 0;

function animate(now) {
    requestAnimationFrame(animate);
    const dt = Math.min((now - prevTime) / 1000, 0.1);
    prevTime = now;

    if (document.getElementById('title-screen').style.display === 'none') {
        if (!state.stocks) state.stocks = generateFreshStocks();
        if (Date.now() - state.stocks.lastReset >= RESTOCK_INTERVAL_MS) {
            resetAllStocks(false);
        }
        restockUiTick += dt;
        if (restockUiTick >= 1.0) {
            restockUiTick = 0;
            const timerEl = document.getElementById('hud-restock-timer');
            if (timerEl) timerEl.innerText = `${getRemainingRestockSec()}s`;
        }
    }

    const mag = Math.hypot(joyVec.x, joyVec.y);
    if (mag > 0.1) {
        const spd = state.poisoned ? 3.6 : 6.4;
        playerObj.position.x += joyVec.x * spd * dt;
        playerObj.position.z += joyVec.y * spd * dt;
        resolvePlayerCollisions(0.55);
        playerObj.rotation.y = Math.atan2(joyVec.x, joyVec.y);
        walkPhase += dt * 14;
        const swing = Math.sin(walkPhase) * 0.55;
        if (legL) { legL.rotation.x = swing; legR.rotation.x = -swing; }
        sfx.stepCooldown = (sfx.stepCooldown || 0) + dt;
        if (sfx.stepCooldown > 0.3) { sfx.stepCooldown = 0; sfx.playStep(); }
    }

    camera.position.x += (playerObj.position.x - camera.position.x) * 6 * dt;
    camera.position.y += (11.0 - camera.position.y) * 6 * dt;
    camera.position.z += (playerObj.position.z + 11.4 - camera.position.z) * 6 * dt;
    camera.lookAt(playerObj.position.x, 1.1, playerObj.position.z - 1.5);

    let found = null;
    for (const zt of zoneTriggers) {
        if (Math.hypot(playerObj.position.x - zt.x, playerObj.position.z - zt.z) <= zt.radius) { found = zt; break; }
    }
    const zBtn = document.getElementById('btn-z');
    if (found) { currentTrigger = found; zBtn.style.display = 'flex'; zBtn.innerText = found.btnText; }
    else { currentTrigger = null; zBtn.style.display = 'none'; }

    if (state.machines.auto_milker && state.planet !== 'alley') {
        autoMilkTick += dt;
        if (autoMilkTick >= 8.0) {
            autoMilkTick = 0;
            const randCow = state.cows[Math.floor(Math.random() * state.cows.length)];
            if (randCow) state.bag.milks[randCow] = (state.bag.milks[randCow] || 0) + 1;
        }
    }

    if (state.poisoned) {
        poisonTick += dt;
        if (poisonTick >= 2.2) { poisonTick = 0; state.hp = Math.max(1, state.hp - 1); updateHUD(); }
    }

    const t = now * 0.003;
    for (const item of animEntities) {
        if (item.kind === 'bob') { item.mesh.position.y = item.baseY + Math.sin(t + item.baseY) * 0.2; item.mesh.rotation.y += dt * 2.0; }
        else if (item.kind === 'flame') { item.mesh.scale.y = 0.8 + Math.sin(now * 0.025) * 0.4; }
    }
    renderer.render(scene, camera);
}

function renderSaveSlotsUI() {
    const container = document.getElementById('save-slots-container');
    document.getElementById('new-name-panel').style.display = 'none';
    let html = '';
    for (let i = 0; i < 3; i++) {
        const slotData = loadSlot(i);
        if (slotData) {
            html += `<div class="slot-card"><div style="font-size:7.5px;">SLOT ${i+1}: ${slotData.name} (${slotData.gold}$)</div><div style="display:flex;gap:5px;"><button onclick="selectExistingSlot(${i})" class="ut-btn ut-btn-green">OYNA</button><button onclick="clearSaveSlot(${i})" class="ut-btn ut-btn-red">SIL</button></div></div>`;
        } else {
            html += `<div class="slot-card"><div style="font-size:8px;">SLOT ${i+1}: [BOS]</div><button onclick="promptNewSlot(${i})" class="ut-btn ut-btn-cyan">+ YENI</button></div>`;
        }
    }
    container.innerHTML = html;
}

window.promptNewSlot = function(slotIdx) {
    sfx.init(); sfx.playSelect(); pendingNewSlot = slotIdx;
    document.getElementById('selected-slot-label').innerText = `* SLOT ${slotIdx+1} ICIN ISIM:`;
    document.getElementById('name-input').value = '';
    document.getElementById('new-name-panel').style.display = 'block';
};

window.selectExistingSlot = function(slotIdx) {
    const data = loadSlot(slotIdx);
    if (!data) return;
    activeSlotIndex = slotIdx;
    startGameWithData(data);
};

window.clearSaveSlot = function(slotIdx) {
    deleteSlot(slotIdx); renderSaveSlotsUI(); showPixelToast(`* SLOT ${slotIdx+1} SILINDI!`);
};

let pendingNewSlot = 0;
document.getElementById('btn-cancel-name').addEventListener('click', () => { document.getElementById('new-name-panel').style.display = 'none'; });
document.getElementById('btn-confirm-start').addEventListener('click', () => {
    const rawName = document.getElementById('name-input').value.trim().toUpperCase();
    activeSlotIndex = pendingNewSlot;
    const freshData = createDefaultState(rawName || `KASIF_${pendingNewSlot+1}`);
    saveSlot(activeSlotIndex, freshData);
    startGameWithData(freshData);
});

function startGameWithData(dataObj) {
    sfx.init(); sfx.playSelect();
    state = { ...createDefaultState('KASIF'), ...dataObj };
    if (!state.stocks) state.stocks = generateFreshStocks();
    state.interior = null;
    document.getElementById('title-screen').style.display = 'none';
    document.getElementById('top-hud').style.display = 'flex';
    document.getElementById('quest-strip').style.display = 'block';
    document.getElementById('mobile-controls').style.display = 'block';
    document.getElementById('poison-vignette').style.display = state.poisoned ? 'block' : 'none';
    buildPlayerVoxel();
    loadPlanetScene(state.planet);
    if (state.planet !== 'alley') playerObj.position.set(0, 0, 3);
    updateHUD(); saveSlot(activeSlotIndex, state);
}

window.addEventListener('resize', updatePixelResolution);
window.onload = () => {
    drawSpriteToCanvas(document.getElementById('title-spr-1'), 'alien');
    drawSpriteToCanvas(document.getElementById('title-spr-2'), 'rocket');
    drawSpriteToCanvas(document.getElementById('rotate-sprite'), 'rocket');
    renderSaveSlotsUI();
    buildPlayerVoxel();
    loadPlanetScene('alley');
    requestAnimationFrame(animate);
};
</script>
