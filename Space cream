function drawRadarMapCanvas() {
    const c = document.getElementById('radar-map-canvas');
    if (!c) return;
    const ctx = c.getContext('2d');
    const W = c.width, H = c.height;
    ctx.clearRect(0, 0, W, H);

    const spanX = Math.max(10, worldBounds.maxX - worldBounds.minX);
    const spanZ = Math.max(10, worldBounds.maxZ - worldBounds.minZ);
    const toPxX = (wx) => ((wx - worldBounds.minX) / spanX) * (W - 24) + 12;
    const toPxY = (wz) => ((wz - worldBounds.minZ) / spanZ) * (H - 24) + 12;

    ctx.strokeStyle = '#1b2238';
    ctx.lineWidth = 1;
    for (let g = 0; g <= W; g += 24) {
        ctx.beginPath(); ctx.moveTo(g, 0); ctx.lineTo(g, H); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(0, g); ctx.lineTo(W, g); ctx.stroke();
    }

    mapLandmarks.forEach(lm => {
        const px = toPxX(lm.x);
        const py = toPxY(lm.z);
        const bw = Math.max(10, (lm.w / spanX) * (W - 24));
        const bh = Math.max(10, (lm.d / spanZ) * (H - 24));

        ctx.fillStyle = lm.color;
        ctx.fillRect(px - bw / 2, py - bh / 2, bw, bh);
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 1;
        ctx.strokeRect(px - bw / 2, py - bh / 2, bw, bh);

        ctx.fillStyle = '#ffffff';
        ctx.font = '6px "Press Start 2P", monospace';
        ctx.textAlign = 'center';
        const shortName = lm.name.length > 11 ? lm.name.slice(0, 10) + '.' : lm.name;
        ctx.fillText(shortName, px, py - bh / 2 - 3);
    });

    const ppx = toPxX(playerObj.position.x);
    const ppy = toPxY(playerObj.position.z);
    ctx.fillStyle = '#ffff00';
    ctx.fillRect(ppx - 4, ppy - 4, 8, 8);
    ctx.strokeStyle = '#000000';
    ctx.lineWidth = 1.5;
    ctx.strokeRect(ppx - 4, ppy - 4, 8, 8);
}

