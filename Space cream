function openCustomerCounterMenu() {
    activeShopMenu = null;
    const milks = Object.keys(state.bag.milks).filter(k => state.bag.milks[k] > 0);
    const fruits = Object.keys(state.bag.fruits).filter(k => state.bag.fruits[k] > 0);
    const mixerMult = state.machines.super_mixer ? 1.5 : 1.0;
    const petMult = state.pets.includes('monster') ? 1.5 : 1.0;
    const shopMult = 1 + (state.shopLevel - 1) * 0.25;

    let html = `<div style="font-size:8px;color:#00ffff;line-height:1.6;">* [${state.shopName || 'DONDURMA DUKKANI'}] UZAYLI MUSTERILER TEZGAHTA! ZEHIRLI DONDURMA SATARSAN TAZMINAT ODERSIN!</div>`;
    if (milks.length === 0 || fruits.length === 0) {
        html += `<div style="font-size:8px;color:#ff8800;padding:10px;">* CANTANDA EN AZ 1 SUT VE 1 MEYVE OLMALI!</div>`;
    } else {
        milks.forEach(mId => {
            const c = COW_CATALOG.find(x => x.id === mId);
            fruits.forEach(fId => {
                const f = FRUIT_CATALOG.find(x => x.id === fId);
                const price = Math.round((c.value + f.value) * 1.6 * mixerMult * petMult * shopMult);
                let poisonChance = Math.min(0.65, (c.poisonRisk + f.poisonRisk) * 0.75);
                if (state.machines.toxin_filter) poisonChance *= 0.25;

                html += `
                <div class="item-row">
                    <div style="font-size:8px;line-height:1.6;">
                        <div style="color:#ff44aa;">${c.milkName} + ${f.name}</div>
                        <div style="color:#aaaaaa;">ZEHIR RISKI: %${Math.round(poisonChance * 100)} | Fiyat: ${price}$</div>
                    </div>
                    <button onclick="doServeCustomer('${mId}','${fId}',${price},${poisonChance})" class="ut-btn ut-btn-cyan">SERVIS YAP</button>
                </div>`;
            });
        });
    }
    showMenu(`* ${state.shopName || 'DONDURMA SERVISI'}`, html);
}

window.doServeCustomer = function(mId, fId, price, poisonChance) {
    if ((state.bag.milks[mId] || 0) <= 0 || (state.bag.fruits[fId] || 0) <= 0) return;
    state.bag.milks[mId]--;
    state.bag.fruits[fId]--;

    if (Math.random() < poisonChance) {
        const fine = Math.max(40, Math.round(price * 0.9));
        state.gold = Math.max(0, state.gold - fine);
        sfx.playPoison();
        unlockAchievement('poison_fine');
        updateHUD();
        saveSlot(activeSlotIndex, state);
        closeMenu();
        if (customerNPCs[0]) {
            customerNPCs[0].headMesh.material.color.setHex(0x00ff44);
            setTimeout(() => { if (customerNPCs[0]) customerNPCs[0].headMesh.material.color.setHex(customerNPCs[0].origColor); }, 3000);
        }
        openDialogue('customer_alien', ['* MUSTERI: "OGHH! MIDEM YANIYOR!"', `* SAGLIK POLISI: "Zehirli dondurma yuzunden ${fine}$ tazminat kesildi!"`]);
    } else {
        state.gold += price;
        sfx.playCoin();
        unlockAchievement('first_sale');
        if (state.gold >= 10000) unlockAchievement('rich_10k');
        updateHUD();
        saveSlot(activeSlotIndex, state);
        showPixelToast(`* +${price}$ KAZANDIN!`);
        openCustomerCounterMenu();
    }
};

