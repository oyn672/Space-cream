let dialogueQueue = [], dialogueCallback = null, typingInterval = null, isTyping = false, currentFullLine = '', isChoiceActive = false, choiceYesFn = null, choiceNoFn = null;

function openDialogue(portraitKey, lines, onComplete = null) {
    isChoiceActive = false;
    document.getElementById('btn-dialogue-next').style.display = 'inline-flex';
    document.getElementById('btn-choice-yes').style.display = 'none';
    document.getElementById('btn-choice-no').style.display = 'none';
    drawSpriteToCanvas(document.getElementById('dialogue-portrait'), portraitKey);
    dialogueQueue = [...lines];
    dialogueCallback = onComplete;
    document.getElementById('dialogue-overlay').style.display = 'flex';
    advanceDialogue();
}

function openChoiceDialogue(portraitKey, questionText, onYes, onNo) {
    isChoiceActive = true;
    choiceYesFn = onYes;
    choiceNoFn = onNo;
    document.getElementById('btn-dialogue-next').style.display = 'none';
    document.getElementById('btn-choice-yes').style.display = 'inline-flex';
    document.getElementById('btn-choice-no').style.display = 'inline-flex';
    drawSpriteToCanvas(document.getElementById('dialogue-portrait'), portraitKey);
    document.getElementById('dialogue-overlay').style.display = 'flex';
    typeSingleLine(questionText);
}

function typeSingleLine(line) {
    clearInterval(typingInterval);
    currentFullLine = line;
    const textEl = document.getElementById('dialogue-text');
    textEl.innerText = '';
    let idx = 0;
    isTyping = true;
    typingInterval = setInterval(() => {
        if (idx < currentFullLine.length) {
            const ch = currentFullLine[idx];
            textEl.innerText += ch;
            if (ch !== ' ' && idx % 2 === 0) sfx.playVoiceBlip(320);
            idx++;
        } else {
            clearInterval(typingInterval);
            isTyping = false;
        }
    }, 24);
}

function advanceDialogue() {
    if (isChoiceActive) return;
    if (isTyping) {
        clearInterval(typingInterval);
        isTyping = false;
        document.getElementById('dialogue-text').innerText = currentFullLine;
        return;
    }
    if (dialogueQueue.length === 0) {
        document.getElementById('dialogue-overlay').style.display = 'none';
        if (dialogueCallback) dialogueCallback();
        return;
    }
    typeSingleLine(dialogueQueue.shift());
}

