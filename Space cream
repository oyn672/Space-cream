function drawSpriteToCanvas(canvasEl, spriteKey) {
    if (!canvasEl) return;
    const ctx = canvasEl.getContext('2d');
    const grid = SPRITES_16[spriteKey] || SPRITES_16.note;
    const w = canvasEl.width;
    const h = canvasEl.height;
    ctx.clearRect(0, 0, w, h);
    const cellW = w / 16;
    const cellH = h / 16;
    for (let y = 0; y < 16; y++) {
        const row = grid[y];
        for (let x = 0; x < 16; x++) {
            const color = PALETTE[row[x]];
            if (color) {
                ctx.fillStyle = color;
                ctx.fillRect(Math.floor(x * cellW), Math.floor(y * cellH), Math.ceil(cellW), Math.ceil(cellH));
            }
        }
    }
}

function spriteImgHTML(spriteKey) {
    const c = document.createElement('canvas');
    c.width = 16;
    c.height = 16;
    drawSpriteToCanvas(c, spriteKey);
    return `<img src="${c.toDataURL()}" class="sprite-icon" alt="">`;
}

function createPixelTexture(bgHex, dotHex, patternType = 'noise') {
    const c = document.createElement('canvas');
    c.width = 16;
    c.height = 16;
    const ctx = c.getContext('2d');
    ctx.fillStyle = bgHex;
    ctx.fillRect(0, 0, 16, 16);
    ctx.fillStyle = dotHex;

    if (patternType === 'grid') {
        ctx.fillRect(0, 0, 16, 1);
        ctx.fillRect(0, 0, 1, 16);
        ctx.fillRect(7, 7, 2, 2);
    } else if (patternType === 'bricks') {
        ctx.fillRect(0, 4, 16, 1);
        ctx.fillRect(0, 12, 16, 1);
        ctx.fillRect(4, 0, 1, 4);
        ctx.fillRect(12, 4, 1, 8);
    } else if (patternType === 'planks') {
        ctx.fillRect(0, 3, 16, 1);
        ctx.fillRect(0, 7, 16, 1);
        ctx.fillRect(0, 11, 16, 1);
        ctx.fillRect(0, 15, 16, 1);
    } else if (patternType === 'checker') {
        for (let y = 0; y < 16; y += 4) {
            for (let x = 0; x < 16; x += 4) {
                if ((x + y) % 8 === 0) ctx.fillRect(x, y, 4, 4);
            }
        }
    } else {
        for (let i = 0; i < 24; i++) {
            ctx.fillRect((i * 7) % 16, (i * 11) % 16, 1, 1);
        }
    }
    const tex = new THREE.CanvasTexture(c);
    tex.magFilter = THREE.NearestFilter;
    tex.minFilter = THREE.NearestFilter;
    tex.wrapS = THREE.RepeatWrapping;
    tex.wrapT = THREE.RepeatWrapping;
    return tex;
}

class ChiptuneAudio {
    constructor() {
        this.ctx = null;
        this.muted = false;
        this.bgmTimer = null;
        this.stepIdx = 0;
    }
    init() {
        if (!this.ctx) {
            const AC = window.AudioContext || window.webkitAudioContext;
            this.ctx = new AC();
        }
        if (this.ctx.state === 'suspended') this.ctx.resume();
        this.startChiptuneLoop();
    }
    toggleMute() {
        this.muted = !this.muted;
        const btn = document.getElementById('btn-hud-mute');
        if (btn) btn.innerText = this.muted ? 'SES:KAPALI' : 'SES:ACIK';
    }
    playSquare(freq, dur, vol = 0.08, type = 'square', slide = null) {
        if (this.muted || !this.ctx) return;
        try {
            const t = this.ctx.currentTime;
            const osc = this.ctx.createOscillator();
            const gain = this.ctx.createGain();
            osc.type = type;
            osc.frequency.setValueAtTime(freq, t);
            if (slide) osc.frequency.exponentialRampToValueAtTime(slide, t + dur);
            gain.gain.setValueAtTime(vol, t);
            gain.gain.setValueAtTime(0.001, t + dur);
            osc.connect(gain);
            gain.connect(this.ctx.destination);
            osc.start(t);
            osc.stop(t + dur);
        } catch (e) {}
    }
    playVoiceBlip(pitch = 330) {
        this.playSquare(pitch + (Math.random() * 40 - 20), 0.04, 0.055, 'square');
    }
    playStep() { this.playSquare(105, 0.035, 0.03, 'triangle', 60); }
    playSelect() {
        this.playSquare(587.33, 0.05, 0.08, 'square');
        setTimeout(() => this.playSquare(880, 0.08, 0.08, 'square'), 50);
    }
    playCoin() {
        this.playSquare(987.77, 0.06, 0.09, 'square');
        setTimeout(() => this.playSquare(1318.51, 0.14, 0.09, 'square'), 65);
    }
    playMine() {
        this.playSquare(320, 0.07, 0.1, 'triangle', 120);
        setTimeout(() => this.playSquare(740, 0.06, 0.08, 'square'), 60);
    }
    playWater() {
        this.playSquare(440, 0.08, 0.08, 'sine', 660);
        setTimeout(() => this.playSquare(550, 0.1, 0.08, 'sine', 820), 70);
    }
    playRocket() { this.playSquare(95, 0.5, 0.12, 'sawtooth', 320); }
    playPoison() {
        this.playSquare(185, 0.22, 0.1, 'sawtooth', 80);
        setTimeout(() => this.playSquare(140, 0.28, 0.1, 'sawtooth', 55), 150);
    }
    playHeal() {
        [523.25, 659.25, 783.99, 1046.5].forEach((f, i) => {
            setTimeout(() => this.playSquare(f, 0.11, 0.08, 'triangle'), i * 70);
        });
    }
    startChiptuneLoop() {
        if (this.bgmTimer) return;
        const leadNotes = [523.25, 0, 392.00, 329.63, 440.00, 0, 392.00, 0, 349.23, 392.00, 440.00, 523.25, 392.00, 0, 329.63, 0];
        const bassNotes = [130.81, 130.81, 196.00, 196.00, 174.61, 174.61, 130.81, 130.81, 146.83, 146.83, 174.61, 174.61, 196.00, 196.00, 130.81, 130.81];
        this.bgmTimer = setInterval(() => {
            if (this.muted || !this.ctx || this.ctx.state !== 'running') return;
            const i = this.stepIdx % leadNotes.length;
            if (leadNotes[i] > 0) this.playSquare(leadNotes[i], 0.15, 0.028, 'square');
            if (bassNotes[i] > 0) this.playSquare(bassNotes[i], 0.17, 0.038, 'triangle');
            this.stepIdx++;
        }, 235);
    }
}
