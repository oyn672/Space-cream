        #poison-vignette {
            display: none;
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 4;
            border: 8px solid #00ff44;
            box-shadow: inset 0 0 40px rgba(0, 255, 68, 0.45);
            animation: poisonBlink 1s steps(2, end) infinite;
        }
        @keyframes poisonBlink {
            0%, 100% { opacity: 0.9; }
            50% { opacity: 0.3; }
        }

        #joy-area {
            position: fixed;
            bottom: 14px;
            left: 14px;
            width: 114px;
            height: 114px;
            z-index: 20;
        }
        #joy-frame {
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.82);
            border: 4px solid #ffffff;
            position: relative;
        }
        #joy-frame::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 10px;
            right: 10px;
            height: 2px;
            background: #444444;
            transform: translateY(-50%);
        }
        #joy-frame::after {
            content: '';
            position: absolute;
            left: 50%;
            top: 10px;
            bottom: 10px;
            width: 2px;
            background: #444444;
            transform: translateX(-50%);
        }
        #joy-knob {
            width: 36px;
            height: 36px;
            background: #ff2222;
            border: 3px solid #ffffff;
            position: absolute;
            top: 35px;
            left: 35px;
