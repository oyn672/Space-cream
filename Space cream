            padding: 7px 9px;
            font-size: 8px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            text-transform: uppercase;
        }
        .ut-btn:active {
            background-color: #ffff00;
            color: #000000;
            border-color: #ffff00;
        }
        .ut-btn-orange { border-color: #ff8800; color: #ff8800; }
        .ut-btn-orange:active { background-color: #ff8800; color: #000000; }
        .ut-btn-green { border-color: #00ff66; color: #00ff66; }
        .ut-btn-green:active { background-color: #00ff66; color: #000000; }
        .ut-btn-cyan { border-color: #00ffff; color: #00ffff; }
        .ut-btn-cyan:active { background-color: #00ffff; color: #000000; }
        .ut-btn-red { border-color: #ff3333; color: #ff3333; }
        .ut-btn-red:active { background-color: #ff3333; color: #000000; }
        .ut-btn-yellow { border-color: #ffff00; color: #ffff00; }
        .ut-btn-yellow:active { background-color: #ffff00; color: #000000; }

        #portrait-lock {
            display: none;
            position: fixed;
            inset: 0;
            background: #000000;
            z-index: 9999;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 24px;
            border: 6px solid #ffffff;
        }
        @media screen and (orientation: portrait) {
            #portrait-lock { display: flex !important; }
