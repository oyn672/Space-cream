window.doEasyUpgrade = function(type) {
    if (type === 'shop') { const c = state.shopLevel * 300; if (state.gold < c) return showPixelToast('* YETERSIZ ALTIN!'); state.gold -= c; state.shopLevel++; }
    else if (type === 'barn') { const c = state.barnLevel * 250; if (state.gold < c) return showPixelToast('* YETERSIZ ALTIN!'); state.gold -= c; state.barnLevel++; }
    else if (type === 'garden') {
        if (state.gardenLevel >= 3) return;
        const c = state.gardenLevel === 1 ? 350 : 1500;
        if (state.gold < c) return showPixelToast('* YETERSIZ ALTIN!');
        state.gold -= c; state.gardenLevel++;
        while (state.plots.length < state.gardenLevel * 2) state.plots.push({ fruitId: null, plantedAt: 0, watered: false, ready: false });
        if (!state.interior && state.planet !== 'alley') refreshPlotVoxels();
    }
    sfx.playCoin(); updateHUD(); saveSlot(activeSlotIndex, state); openEasyUpgradesMenu();
};

