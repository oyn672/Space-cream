function createFloatingLabel(text, yPos, borderColor = '#ffff00', textColor = '#ffffff') {
    const c = document.createElement('canvas');
    const len = Math.max(8, text.length);
    c.width = len * 24 + 48;
    c.height = 68;
    const ctx = c.getContext('2d');
    ctx.fillStyle = '#000000';
    ctx.fillRect(0, 0, c.width, c.height);
    ctx.strokeStyle = borderColor;
    ctx.lineWidth = 8;
    ctx.strokeRect(4, 4, c.width - 8, c.height - 8);
    ctx.fillStyle = textColor;
    ctx.font = 'bold 26px "Press Start 2P", monospace';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(text, c.width / 2, c.height / 2 + 2);

    const tex = new THREE.CanvasTexture(c);
    tex.magFilter = THREE.NearestFilter;
    tex.minFilter = THREE.NearestFilter;
    const mat = new THREE.SpriteMaterial({ map: tex, transparent: true });
    const spr = new THREE.Sprite(mat);
    spr.scale.set(c.width / 52, c.height / 52, 1);
    spr.position.y = yPos;
    return spr;
}

function addSolidBox(cx, cz, widthX, depthZ) {
    solidColliders.push({
        minX: cx - widthX / 2, maxX: cx + widthX / 2,
        minZ: cz - depthZ / 2, maxZ: cz + depthZ / 2
    });
}

function resolvePlayerCollisions(radius = 0.55) {
    playerObj.position.x = Math.max(worldBounds.minX + radius, Math.min(worldBounds.maxX - radius, playerObj.position.x));
    playerObj.position.z = Math.max(worldBounds.minZ + radius, Math.min(worldBounds.maxZ - radius, playerObj.position.z));

    for (let i = 0; i < solidColliders.length; i++) {
        const b = solidColliders[i];
        const closestX = Math.max(b.minX, Math.min(playerObj.position.x, b.maxX));
        const closestZ = Math.max(b.minZ, Math.min(playerObj.position.z, b.maxZ));
        const dx = playerObj.position.x - closestX;
        const dz = playerObj.position.z - closestZ;
        const distSq = dx * dx + dz * dz;

        if (distSq < radius * radius) {
            const dist = Math.sqrt(distSq);
            if (dist > 0.0001) {
                const overlap = radius - dist;
                playerObj.position.x += (dx / dist) * overlap;
                playerObj.position.z += (dz / dist) * overlap;
            } else {
                playerObj.position.x = b.minX - radius;
            }
        }
    }
}

