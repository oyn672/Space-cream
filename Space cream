    <div class="item-row"><div style="font-size:8px;color:#00ff66;">ZEHIR TEDAVISI (50$)</div><button onclick="doHospitalHeal()" class="ut-btn ut-btn-green">TEDAVI</button></div>
    <div class="item-row"><div style="font-size:8px;color:#ffff00;">UZAYLI GENI TEMIZLEME ASISI (${CURE_VACCINE_COST}$)</div><button onclick="doFinalCure()" class="ut-btn ut-btn-yellow">ASIYI AL</button></div>`;
